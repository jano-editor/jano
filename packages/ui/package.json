{
  "name": "@jano-editor/ui",
  "version": "1.0.0",
  "description": "Terminal UI library for jano editor",
  "keywords": [
    "ansi",
    "jano",
    "terminal",
    "tui",
    "ui"
  ],
  "homepage": "https://janoeditor.dev",
  "bugs": "https://github.com/jano-editor/jano/issues",
  "license": "MIT",
  "author": "Florian Heuberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jano-editor/jano.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
